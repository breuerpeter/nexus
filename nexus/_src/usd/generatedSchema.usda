#usda 1.0
(
    doc = """The nexus component schemas, written by hand. Each attribute's doc ends with its Range and
    Units lines, which the schema reference page renders."""
)

class "NexusImuAPI" (
    doc = "An inertial measurement unit on its mount prim: an accelerometer and a gyroscope, each with white noise."
)
{
    float nexus:accNoise = 0.02 (
        doc = """Standard deviation of the white noise on each accelerometer axis, per sample.

        Range: [0, inf)
        Units: meters per second squared"""
    )
    float nexus:gyroNoise = 0.02 (
        doc = """Standard deviation of the white noise on each gyroscope axis, per sample.

        Range: [0, inf)
        Units: radians per second"""
    )
}

class "NexusPropellerAPI" (
    doc = "A propeller on its rotor's rigid body, the child body of the rotor's revolute joint: its thrust, its reaction torque and its in-plane drag, from the rotor's speed and the airflow at its hub."
)
{
    float nexus:ct = 0 (
        doc = """Thrust coefficient: the static thrust is this value times the square of the rotor speed in revolutions per minute. At 0 the propeller makes no thrust.

        Range: [0, inf)
        Units: newtons per (revolution per minute) squared"""
    )
    float nexus:cd = 0 (
        doc = """Reaction torque per unit of thrust: the drag torque about the rotor's axis is this value times the thrust.

        Range: [0, inf)
        Units: meters"""
    )
    float nexus:aeroH = 0 (
        doc = """Thrust lost in forward flight: the thrust falls by this value times the square of the airflow speed in the rotor's plane. At 0 the thrust depends on the rotor speed alone.

        Range: [0, inf)
        Units: kilograms per meter"""
    )
    float nexus:aeroHforce = 0 (
        doc = """In-plane drag of the rotor: a force against the airflow in the rotor's plane, of this value times the rotor speed times the airflow speed.

        Range: [0, inf)
        Units: kilograms per radian"""
    )
}

class "NexusPx4API" (
    doc = "PX4 flies the vehicle over its Software In The Loop (SITL) link, on the vehicle's root prim."
)
{
    string nexus:airframe = "" (
        doc = """The SITL airframe make target without PX4's `none_` prefix: `astro_max` runs `make px4_sitl none_astro_max`. The build fails when it is empty.

        Range: a PX4 SITL airframe name
        Units: none"""
    )
}

class "NexusPx4SitlAPI" (
    doc = """The PX4 Software In The Loop (SITL) peer, on the vehicle's root prim beside `NexusPx4API`: the run starts PX4 SITL and stops it with the run. A layer that drops it flies an autopilot started elsewhere, which dials instance 0's Hardware In The Loop (HIL) port, 4560."""
)
{
}
