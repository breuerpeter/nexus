.venv/
site/
__pycache__/
*.pyc

# Build / packaging artifacts
dist/
# Only the root build/ folder: nexus/_src/build/ is a package.
/build/
*.egg-info/

# Tool caches
.ruff_cache/
.pytest_cache/
.import_linter_cache/
.mypy_cache/

*.rrd
.rl-artifacts/

# mkdocs social-card plugin build cache
.cache/

# Example and benchmark run artifacts (scripts/ci/benchmark_cell.py and the GPU example workflows)
.eval-artifacts/
assets/local/
# Content-addressed download cache (the asset resolver's default in a source checkout).
assets/cache/

# Secrets — Cesium ion access token (CESIUM_ION_TOKEN); managed locally, never committed
.cesium_token

# Claude Code local state — keep only the checked-in project skills
/.claude/*
!/.claude/skills/

# Claude Code per-checkout instructions; never committed
CLAUDE.local.md

# Vale fetches the prose styles that .vale.ini pins; only the vocabulary is ours.
.vale/styles/*
!.vale/styles/config/

# coverage.py data, written by the pytest --cov run CI uses
.coverage
