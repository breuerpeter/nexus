{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "bump-minor-pre-major": true,
      "package-name": "nexus-uav",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "toml", "path": "uv.lock", "jsonpath": "$.package[?(@.name.value=='nexus-uav')].version" },
        { "type": "toml", "path": "nexus-rl/uv.lock", "jsonpath": "$.package[?(@.name.value=='nexus-uav')].version" }
      ]
    }
  }
}
