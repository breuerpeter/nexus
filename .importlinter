[importlinter]
root_package = nexus_uav
; type-only imports (under TYPE_CHECKING) are annotations, not runtime layering
exclude_type_checking_imports = True
; the Kit contract below names third-party packages, so they have to be in the graph
include_external_packages = True

[importlinter:contract:layers]
name = nexus layered architecture
type = layers
layers =
    nexus_uav._src.cli
    nexus_uav._src.api
    nexus_uav._src.build
    nexus_uav._src.rendering
    nexus_uav._src.physics : nexus_uav._src.guidance
    nexus_uav._src.scene
    nexus_uav._src.vehicle
    nexus_uav._src.recording
    nexus_uav._src.logging
    nexus_uav._src.config
    nexus_uav._src.peers
    nexus_uav._src.assets
    nexus_uav._src.transform
    nexus_uav._src.core
    nexus_uav._src.usd

[importlinter:contract:src-never-examples]
name = the core never imports the examples (examples depend on core, one-way)
type = forbidden
source_modules =
    nexus_uav._src
forbidden_modules =
    nexus_uav.examples

; No generic part names PX4: the loop, the components and Sim carry no PX4 class, port or verb, so the
; script that commands PX4 is what names it, through the public namespace nexus_uav.px4. The one import that
; remains is the argument parser's, which prints the HIL port in a help string. A new one fails here.
[importlinter:contract:no-px4-in-generic-code]
name = no generic part names PX4
type = forbidden
; module by module: a forbidden package inside a source package is skipped as a package, not checked
as_packages = False
; a failure names the one import to remove, not every chain that runs through it
allow_indirect_imports = True
source_modules =
    nexus_uav._src.**
forbidden_modules =
    nexus_uav._src.peers.px4_sitl
    nexus_uav._src.peers.px4_sitl.**
    nexus_uav._src.vehicle.controllers.px4
    nexus_uav._src.vehicle.controllers.px4.**
    nexus_uav.px4
ignore_imports =
    ; PX4's own folders speak to each other
    nexus_uav._src.peers.px4_sitl.** -> nexus_uav._src.peers.px4_sitl
    nexus_uav._src.peers.px4_sitl.** -> nexus_uav._src.peers.px4_sitl.**
    nexus_uav._src.vehicle.controllers.px4 -> nexus_uav._src.vehicle.controllers.px4.**
    nexus_uav._src.vehicle.controllers.px4.** -> nexus_uav._src.peers.px4_sitl
    ; the argument parser
    nexus_uav._src.api.args -> nexus_uav._src.peers.px4_sitl

; Every Kit call lives in the Kit render peer's program, peers/kit/peer-src/, package data that no module
; imports, so Kit stays out of every tier with no exception.
[importlinter:contract:no-kit]
name = Kit stays out of every tier
type = forbidden
source_modules =
    nexus_uav
forbidden_modules =
    omni
    usdrt
    isaacsim
    carb

; The render stage talks to the renderer through six calls and no other, so it is the one module that imports
; ovrtx and ovstage, the extra nexus-uav[rtx]. It imports them in its start, which this contract can't tell from a
; module-level import; tests/build/test_rtx_build.py proves a run with no RTX sensor loads neither.
[importlinter:contract:ovrtx-only-in-the-render-stage]
name = only the render stage imports ovrtx and ovstage
type = forbidden
; module by module, as the PX4 contract checks
as_packages = False
; a failure names the one import to remove, not every chain that runs through it
allow_indirect_imports = True
source_modules =
    nexus_uav.**
forbidden_modules =
    ovrtx
    ovstage
ignore_imports =
    nexus_uav._src.vehicle.sensors.rtx.stage -> ovrtx
    nexus_uav._src.vehicle.sensors.rtx.stage -> ovstage
