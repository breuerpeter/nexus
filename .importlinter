[importlinter]
root_package = nexus
; type-only imports (under TYPE_CHECKING) are annotations, not runtime layering
exclude_type_checking_imports = True
; the Kit contract below names third-party packages, so they have to be in the graph
include_external_packages = True

[importlinter:contract:layers]
name = nexus layered architecture
type = layers
layers =
    nexus._src.cli
    nexus._src.api
    nexus._src.build
    nexus._src.rendering
    nexus._src.physics : nexus._src.operator
    nexus._src.scene
    nexus._src.vehicle
    nexus._src.recording
    nexus._src.logging
    nexus._src.config
    nexus._src.assets
    nexus._src.transform
    nexus._src.core

[importlinter:contract:src-never-examples]
name = the core never imports the examples (examples depend on core, one-way)
type = forbidden
source_modules =
    nexus._src
forbidden_modules =
    nexus.examples

; Every Kit call lives in the Kit render peer's program, kit-peer/, package data that no module
; imports, so Kit stays out of every tier with no exception.
[importlinter:contract:no-kit]
name = Kit stays out of every tier
type = forbidden
source_modules =
    nexus
forbidden_modules =
    omni
    usdrt
    isaacsim
    carb
