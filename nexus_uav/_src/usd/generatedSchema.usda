#usda 1.0
(
    doc = """The nexus component schemas, written by hand. Each attribute's doc ends with its Range and
    Units lines, which the schema reference page renders."""
)

class "NexusImuAPI" (
    doc = "An inertial measurement unit on its mount prim, a geometry prim under the body it rides, which Newton loads as a site: an accelerometer and a gyroscope, each with white noise."
    prepend apiSchemas = ["NexusSensorRoleAPI", "NewtonSiteAPI"]
)
{
    float nexus:accNoise = 0.02 (
        doc = """Standard deviation of the white noise on each accelerometer axis, per sample.

        Range: [0, inf)
        Units: meters per second squared"""
    )
    float nexus:gyroNoise = 0.02 (
        doc = """Standard deviation of the white noise on each gyroscope axis, per sample.

        Range: [0, inf)
        Units: radians per second"""
    )
    float nexus:rate = 0 (
        doc = """How often the sensor gives a new sample. 0 gives one every control tick.

        Range: [0, inf)
        Units: hertz"""
    )
}

class "NexusMagAPI" (
    doc = "A magnetometer on its mount prim, a geometry prim at the origin of the body it rides, which Newton loads as a site: the scene's magnetic field in the body's axes, with an offset and white noise."
    prepend apiSchemas = ["NexusSensorRoleAPI", "NewtonSiteAPI"]
)
{
    float3 nexus:offset = (0, 0, 0) (
        doc = """A constant offset added to the field on each body axis.

        Range: (-inf, inf)
        Units: gauss"""
    )
    float3 nexus:noise = (0.02, 0.02, 0.03) (
        doc = """Standard deviation of the white noise on each body axis, per sample.

        Range: [0, inf)
        Units: gauss"""
    )
    float nexus:rate = 0 (
        doc = """How often the sensor gives a new sample. 0 gives one every control tick.

        Range: [0, inf)
        Units: hertz"""
    )
}

class "NexusBaroAPI" (
    doc = "A barometer on its mount prim, a geometry prim at the origin of the body it rides, which Newton loads as a site: the scene's pressure at sea level brought to the body's altitude, with white noise."
    prepend apiSchemas = ["NexusSensorRoleAPI", "NewtonSiteAPI"]
)
{
    float nexus:noise = 0.02 (
        doc = """Standard deviation of the white noise on the pressure, per sample.

        Range: [0, inf)
        Units: hectopascals"""
    )
    float nexus:rate = 0 (
        doc = """How often the sensor gives a new sample. 0 gives one every control tick.

        Range: [0, inf)
        Units: hertz"""
    )
}

class "NexusGpsAPI" (
    doc = "A Global Positioning System (GPS) receiver on its mount prim, a geometry prim at the origin of the body it rides, which Newton loads as a site: the body's position and velocity from the scene's geodetic origin."
    prepend apiSchemas = ["NexusSensorRoleAPI", "NewtonSiteAPI"]
)
{
    int nexus:fixType = 3 (
        doc = """The fix the receiver reports, a MAVLink `GPS_FIX_TYPE` value: 3 is a 3D fix.

        Range: [0, 8]
        Units: none"""
    )
    float nexus:rate = 0 (
        doc = """How often the sensor gives a new sample. 0 gives one every control tick.

        Range: [0, inf)
        Units: hertz"""
    )
}

class "NexusCameraAPI" (
    doc = "A color camera on a `Camera` prim, which gives its optics and its mount. The Kit render peer renders it, and no vehicle names that peer: the camera's class requires it."
    prepend apiSchemas = ["NexusSensorRoleAPI"]
)
{
    int nexus:width = 1280 (
        doc = """Width of the image.

        Range: [1, inf)
        Units: pixels"""
    )
    int nexus:height = 720 (
        doc = """Height of the image.

        Range: [1, inf)
        Units: pixels"""
    )
    float nexus:rate = 24 (
        doc = """How often the sensor gives a new frame, on sim time.

        Range: [0, inf)
        Units: hertz"""
    )
}

class "NexusThermalCameraAPI" (
    doc = "A Long Wave Infrared (LWIR) camera on a `Camera` prim, which gives its optics and its mount. The Kit render peer renders it at half the declared size on each side, and the camera's class requires that peer."
    prepend apiSchemas = ["NexusSensorRoleAPI"]
)
{
    int nexus:width = 1280 (
        doc = """Width of the render, twice the width of the image.

        Range: [2, inf)
        Units: pixels"""
    )
    int nexus:height = 1024 (
        doc = """Height of the render, twice the height of the image.

        Range: [2, inf)
        Units: pixels"""
    )
    float nexus:rate = 24 (
        doc = """How often the sensor gives a new frame, on sim time.

        Range: [0, inf)
        Units: hertz"""
    )
}

class "NexusLidarAPI" (
    doc = "A lidar on an `OmniLidar` prim, which gives its scan pattern and its mount. The Kit render peer renders it, and the lidar's class requires that peer."
    prepend apiSchemas = ["NexusSensorRoleAPI"]
)
{
    float nexus:rate = 10 (
        doc = """How often the sensor gives a full scan, on sim time.

        Range: [0, inf)
        Units: hertz"""
    )
}

class "NexusPropellerAPI" (
    doc = "A propeller on its rotor's rigid body, the child body of the rotor's revolute joint: its thrust, its reaction torque and its in-plane drag, from the rotor's speed and the airflow at its hub."
    prepend apiSchemas = ["NexusForceRoleAPI"]
)
{
    float nexus:ct = 0 (
        doc = """Thrust coefficient: the static thrust is this value times the square of the rotor speed in revolutions per minute. At 0 the propeller makes no thrust.

        Range: [0, inf)
        Units: newtons per (revolution per minute) squared"""
    )
    float nexus:cd = 0 (
        doc = """Reaction torque per unit of thrust: the drag torque about the rotor's axis is this value times the thrust.

        Range: [0, inf)
        Units: meters"""
    )
    float nexus:aeroH = 0 (
        doc = """Thrust lost in forward flight: the thrust falls by this value times the square of the airflow speed in the rotor's plane. At 0 the thrust depends on the rotor speed alone.

        Range: [0, inf)
        Units: kilograms per meter"""
    )
    float nexus:aeroHforce = 0 (
        doc = """In-plane drag of the rotor: a force against the airflow in the rotor's plane, of this value times the rotor speed times the airflow speed.

        Range: [0, inf)
        Units: kilograms per radian"""
    )
}

class "NexusPx4API_1" (
    doc = "PX4 flies the vehicle over its Software In The Loop (SITL) link, on the controller's `Scope`, a child of the vehicle's root prim named `Controller` by convention. Version 1 leaves the airframe to the PX4 SITL peer, `NexusPx4SitlAPI`."
    prepend apiSchemas = ["NexusControllerRoleAPI"]
)
{
    rel nexus:inputs:imu (
        doc = "The Inertial Measurement Unit (IMU) whose sample PX4 receives, where the vehicle declares more than one."
    )
    rel nexus:inputs:mag (
        doc = "The magnetometer whose sample PX4 receives, where the vehicle declares more than one."
    )
    rel nexus:inputs:baro (
        doc = "The barometer whose sample PX4 receives, where the vehicle declares more than one."
    )
    rel nexus:inputs:gps (
        doc = "The Global Positioning System (GPS) receiver whose sample PX4 receives, where the vehicle declares more than one."
    )
}

class "NexusPx4SitlAPI" (
    doc = """The PX4 Software In The Loop (SITL) peer, on a `Scope` of its own under the vehicle's root prim, named `Px4Sitl` by convention: the run starts PX4 SITL on its airframe and stops it with the run. A layer that deactivates its prim flies an autopilot started elsewhere, which dials instance 0's Hardware In The Loop (HIL) port, 4560."""
)
{
    string nexus:airframe = "" (
        doc = """The SITL airframe make target without PX4's `none_` prefix: `astro_max` runs `make px4_sitl none_astro_max`. The build fails when it is empty, before any peer starts.

        Range: a PX4 SITL airframe name
        Units: none"""
    )
}

class "NexusSceneAPI" (
    doc = """Where a scene sits on Earth and the world's values that follow from it, on the scene's `PhysicsScene` prim. A run's build fails on a scene whose `PhysicsScene` authors no origin, and an override layer moves it. Each value is an attribute of Newton's model at world frequency, in its `nexus` namespace, which the sensors read."""
)
{
    double3 nexus:geodeticOrigin (
        doc = """The WGS84 point the scene's world origin sits at: latitude, longitude and the altitude over mean sea level. For a streamed globe the altitude is the surface's ellipsoidal height, so the street sits at the world origin.

        Range: latitude [-90, 90], longitude [-180, 180], altitude any
        Units: degrees, degrees, metres"""
    )
    float3 nexus:magneticField (
        doc = """Earth's magnetic field in the world's axes, X north, Y west, Z up. Unauthored, the build derives it from the origin through the World Magnetic Model table PX4 checks against.

        Range: (-inf, inf)
        Units: gauss"""
    )
    float nexus:seaLevelPressure = 1013.25 (
        doc = """Air pressure at mean sea level, which a barometer brings to its body's altitude through the standard atmosphere.

        Range: (0, inf)
        Units: hectopascals"""
    )
    float nexus:temperature = 25 (
        doc = """Air temperature, which a barometer reports.

        Range: (-273.15, inf)
        Units: degrees Celsius"""
    )
}

class "NexusSensorRoleAPI" (
    doc = "The sensor role, which a sensor's schema includes as a built-in. A sensor sits on its mount prim, whose parent is the rigid body it rides, and runs in the sensors' place in the tick."
)
{
}

class "NexusEstimatorRoleAPI" (
    doc = "The estimator role, which an estimator's schema includes as a built-in. An estimator sits on a `Scope` of its own whose parent is the vehicle's root prim, named `Estimator` by convention, and writes the estimate after the sensors in the tick. A vehicle declares one estimator at most."
)
{
}

class "NexusControllerRoleAPI" (
    doc = "The controller role, which a controller's schema includes as a built-in. A controller sits on a `Scope` of its own whose parent is the vehicle's root prim, named `Controller` by convention. A vehicle declares one controller."
)
{
}

class "NexusGuidanceRoleAPI" (
    doc = "The guidance role, which a guidance's schema includes as a built-in. A guidance sits on a `Scope` of its own whose parent is the vehicle's root prim, named `Guidance` by convention, and writes the setpoint before the controller in the tick. A vehicle declares one guidance at most."
)
{
}

class "NexusForceRoleAPI" (
    doc = "The force element's role, which the schema of a part that applies a force includes as a built-in, as a propeller's does."
)
{
}

class "NexusCommandRoleAPI" (
    doc = "The command element's role, which the schema of a part that turns the controls into Newton's control inputs includes as a built-in. A command element runs before the force elements on each physics substep."
)
{
}
