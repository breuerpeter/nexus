#usda 1.0
(
    defaultPrim = "Vehicle"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Vehicle" (
    prepend apiSchemas = ["NexusPx4API", "NexusPx4SitlAPI"]
)
{
    string nexus:airframe = "astro_max"

    def Xform "body"
    {
        def Xform "Imu" (
            prepend apiSchemas = ["NexusImuAPI"]
        )
        {
            float nexus:accNoise = 0.05
            double3 xformOp:translate = (0.01, -0.02, 0.03)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "Mag" (
            prepend apiSchemas = ["NexusMagAPI"]
        )
        {
        }

        def Xform "Baro" (
            prepend apiSchemas = ["NexusBaroAPI"]
        )
        {
        }

        def Xform "Gps" (
            prepend apiSchemas = ["NexusGpsAPI"]
        )
        {
        }

        def Camera "Cam" (
            prepend apiSchemas = ["NexusCameraAPI"]
        )
        {
        }

        def Camera "Ir" (
            prepend apiSchemas = ["NexusThermalCameraAPI"]
        )
        {
        }

        def OmniLidar "Lidar" (
            prepend apiSchemas = ["NexusLidarAPI"]
        )
        {
        }
    }
}

