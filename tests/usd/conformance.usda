#usda 1.0
(
    defaultPrim = "Vehicle"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Vehicle"
{
    def Scope "Controller" (
        prepend apiSchemas = ["NexusPx4API_1"]
    )
    {
    }

    def Scope "Px4Sitl" (
        prepend apiSchemas = ["NexusPx4SitlAPI"]
    )
    {
        string nexus:airframe = "astro_max"
    }

    def Xform "body"
    {
        def Sphere "Imu" (
            prepend apiSchemas = ["NexusImuAPI"]
        )
        {
            float nexus:accNoise = 0.05
            double radius = 0.01
            double3 xformOp:translate = (0.01, -0.02, 0.03)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "Mag" (
            prepend apiSchemas = ["NexusMagAPI"]
        )
        {
            double radius = 0.01
        }

        def Sphere "Baro" (
            prepend apiSchemas = ["NexusBaroAPI"]
        )
        {
            double radius = 0.01
        }

        def Sphere "Gps" (
            prepend apiSchemas = ["NexusGpsAPI"]
        )
        {
            double radius = 0.01
        }

        def Camera "Cam" (
            prepend apiSchemas = ["NexusCameraAPI"]
        )
        {
        }

        def Camera "Ir" (
            prepend apiSchemas = ["NexusThermalCameraAPI"]
        )
        {
        }

        def OmniLidar "Lidar" (
            prepend apiSchemas = ["NexusLidarAPI"]
        )
        {
        }
    }

    def Xform "rotor" (
        prepend apiSchemas = ["NexusPropellerAPI", "NexusEscAPI"]
    )
    {
        int nexus:channel = 0
        float nexus:ct = 0.000003463
    }
}

