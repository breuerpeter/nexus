#usda 1.0
(
    defaultPrim = "Vehicle"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Vehicle"
{
    def Scope "Controller" (
        prepend apiSchemas = ["NexusPx4API_1"]
    )
    {
    }

    def Scope "Px4Sitl" (
        prepend apiSchemas = ["NexusPx4SitlAPI"]
    )
    {
        string nexus:airframe = "astro_max"
    }

    def Scope "XrceAgent" (
        prepend apiSchemas = ["NexusXrceAgentAPI"]
    )
    {
    }

    def Xform "body"
    {
        def Sphere "Imu" (
            prepend apiSchemas = ["NexusImuAPI"]
        )
        {
            float nexus:accNoise = 0.05
            double radius = 0.01
            double3 xformOp:translate = (0.01, -0.02, 0.03)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "Mag" (
            prepend apiSchemas = ["NexusMagAPI"]
        )
        {
            double radius = 0.01
        }

        def Sphere "Baro" (
            prepend apiSchemas = ["NexusBaroAPI"]
        )
        {
            double radius = 0.01
        }

        def Sphere "Gps" (
            prepend apiSchemas = ["NexusGpsAPI"]
        )
        {
            double radius = 0.01
        }

        def Camera "Cam" (
            prepend apiSchemas = ["NexusCameraAPI"]
        )
        {
        }

        def Camera "Ir" (
            prepend apiSchemas = ["NexusThermalCameraAPI"]
        )
        {
        }

        def OmniLidar "Lidar" (
            prepend apiSchemas = ["NexusLidarAPI"]
        )
        {
        }
    }

    def Xform "rotor" (
        prepend apiSchemas = ["NexusPropellerAPI", "NexusEscAPI", "NexusMotorAPI"]
    )
    {
        float nexus:busVoltage = 25.2
        int nexus:channel = 0
        float nexus:ct = 0.000003463
        float nexus:currentLimit = 126
        float nexus:kv = 151
        float nexus:resistance = 0.16
    }

    def PhysicsRevoluteJoint "joint" (
        prepend apiSchemas = ["NexusTorqueMotorAPI"]
    )
    {
        int nexus:channel = 4
        float nexus:currentLimit = 2
        float nexus:torqueConstant = 0.05
    }

    def Scope "GimbalController" (
        prepend apiSchemas = ["NexusGimbalControllerAPI"]
    )
    {
        float nexus:attitudeGain = 40
        float nexus:rateLimit = 2.5
    }
}

